# Solver output -- versioned with DVC, not git. See docs/storage.md.
*.s3d
*.sf
*.bf
*.prt5
*.restart
*.bnd
*.gbnd
*.sz
*.be
*.out
*.log
*.smv
*.smv.bak
*.ini
# ... except a viewpoint kept deliberately beside an experiment.  FDS and
# Smokeview write .ini files as scratch inside case directories, but the render
# configs name one as `ini_template` and a clone needs it to reproduce a gif.
!experiments/*/view.ini
*.ssf
*.csv
*.gcf
*.ge
*.ge2
*.ter
*.end
*.stop
*.err

# Never store restart files: 88 MB each, worthless once a solve completes.
*.restart

# Rendered frame dumps (keep the gif, not the frames)
anim*/

# Python
__pycache__/
*.pyc
.venv/
venv/

# macOS
.DS_Store

# The engine and the working area -- not committed. See FDS/README.md.
# The exceptions are our own code that has to sit beside the engine.
FDS/*
!FDS/README.md
!FDS/bin/

# Local DVC mirror -- the data itself lives in the HF bucket
hf_dvc_mirror/
FDS/hf_dvc_mirror/
