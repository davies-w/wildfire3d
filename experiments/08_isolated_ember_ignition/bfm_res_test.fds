! Can the Boundary Fuel Model predict fire spread at coarse cell sizes?
! NIST's bundled examples use 0.05 m cells.  This is 1.0 m.
&HEAD CHID='bfm_res_test', TITLE='Boundary fuel model spread at 1 m cells' /

&TIME T_END=60. /
&MESH IJK=20,8,6, XB=0,20, 0,8, 0,6 /

&WIND SPEED=3.0, DIRECTION=270.0 /

&SPEC ID='WOOD FUEL VAPOR', C=3.4, H=6.2, O=2.5 /
&SPEC ID='WATER VAPOR' /
&REAC FUEL='WOOD FUEL VAPOR', SOOT_YIELD=0.02, HEAT_OF_COMBUSTION=17260. /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

! --- vegetation as a porous boundary layer, NOT a level set ---------------
! MASS_PER_VOLUME is the parameter that triggers the Boundary Fuel Model.
! load = MASS_PER_VOLUME * THICKNESS(1) = 0.5 * 0.4 = 0.2 kg/m2
&SURF ID = 'GRASS'
      DEFAULT = .TRUE.
      MATL_ID = 'Dry Grass','SOIL'
      MOISTURE_CONTENT(1) = 0.08
      MASS_PER_VOLUME(1) = 0.5
      SURFACE_VOLUME_RATIO(1) = 5000.
      THICKNESS(1:2) = 0.4,0.1
      DRAG_COEFFICIENT = 2.8
      RGB = 138,129,62 /

&MATL ID = 'Dry Grass'
      DENSITY = 400.
      CONDUCTIVITY = 0.1
      SPECIFIC_HEAT = 1.5 /

&MATL ID = 'SOIL'
      CONDUCTIVITY = 0.25
      SPECIFIC_HEAT = 2.
      DENSITY = 1300. /

! --- ignition: a small burner patch on the ground -------------------------
&SURF ID = 'IGNITER', HRRPUA = 1000., RAMP_Q = 'ign', COLOR = 'RED' /
&RAMP ID = 'ign', T = 0.,  F = 0. /
&RAMP ID = 'ign', T = 2.,  F = 1. /
&RAMP ID = 'ign', T = 8.,  F = 1. /
&RAMP ID = 'ign', T = 10., F = 0. /
&VENT XB=1,3, 3,5, 0,0, SURF_ID='IGNITER' /

! --- outputs -------------------------------------------------------------
&DEVC ID='HRR', QUANTITY='HRR', XB=0,20, 0,8, 0,6 /
&DEVC ID='burnt', QUANTITY='BURNING RATE',
      SPATIAL_STATISTIC='SURFACE INTEGRAL', TEMPORAL_STATISTIC='TIME INTEGRAL',
      XB=0,20, 0,8, 0,6, IOR=3 /

&SLCF PBY=4.0, QUANTITY='TEMPERATURE' /

&DUMP DT_HRR=1., DT_DEVC=1., DT_SLCF=2. /

&TAIL /
