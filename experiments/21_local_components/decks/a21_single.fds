&DEVC ID='house_burn_max', QUANTITY='BURNING RATE', SURF_ID='HOUSE', XB=15,25,7,17,0,7, SPATIAL_STATISTIC='MAX', TEMPORAL_STATISTIC='INSTANT VALUE' /
