&HEAD CHID='s28_test_0', TITLE='Frozen particle tree-type transfer pilot' /
&MESH IJK=48,32,32, XB=0,24,0,16,0,16 /
&TIME T_END=180 /



&MISC RND_SEED=4321, BNDF_DEFAULT=T /
&WIND SPEED=3.26382271, DIRECTION=270. /
&REAC FUEL='FUEL VAPOR', C=2.10, H=6.20, O=2.16, SOOT_YIELD=0.01, HEAT_OF_COMBUSTION=17425., IDEAL=T /

&SPEC ID='WATER VAPOR' /

&MATL ID                    = 'GENERIC VEGETATION'
      DENSITY               = 500.
      CONDUCTIVITY          = 0.2
      SPECIFIC_HEAT_RAMP    = 'c_v'
      A                     = 1040.
      E                     = 61041.
      NU_SPEC               = 0.75
      SPEC_ID               = 'FUEL VAPOR'
      NU_MATL               = 0.25
      MATL_ID               = 'CHAR'
      HEAT_OF_REACTION      = 418. /

&MATL ID                    = 'CHAR'
      DENSITY               = 300.
      CONDUCTIVITY          = 0.052
      SPECIFIC_HEAT_RAMP    = 'c_v'
      SURFACE_OXIDATION_MODEL = T
      A                  = 465.
      E                  = 68000. 
      SPEC_ID               = 'PRODUCTS','AIR'
      NU_SPEC               = 8.13,-7.17
      MATL_ID               = 'ASH'
      NU_MATL               = 0.04
      HEAT_OF_REACTION      = -25000. /

&MATL ID                    = 'ASH'
      DENSITY               = 67.
      CONDUCTIVITY          = 0.1
      SPECIFIC_HEAT_RAMP    = 'c_v' /

&RAMP ID='c_v', T=  0., F=1.1 /
&RAMP ID='c_v', T=200., F=2.0 /
&RAMP ID='c_v', T=800., F=2.0 /


&SURF ID                        = 'foliage'
      MATL_ID(1,1) = 'GENERIC VEGETATION'
      MATL_MASS_FRACTION(1,1) = 1.0
      MOISTURE_CONTENT = 0.12
      SURFACE_VOLUME_RATIO      = 3940.
      LENGTH                    = 0.05
      GEOMETRY                  = 'CYLINDRICAL' /

&SURF ID                        = 'small roundwood'
      MATL_ID(1,1) = 'GENERIC VEGETATION'
      MATL_MASS_FRACTION(1,1) = 1.0
      MOISTURE_CONTENT = 0.12
      SURFACE_VOLUME_RATIO      = 2667.
      LENGTH                    = 0.10
      GEOMETRY                  = 'CYLINDRICAL' /

&SURF ID                        = 'medium roundwood'
      MATL_ID(1,1) = 'GENERIC VEGETATION'
      MATL_MASS_FRACTION(1,1) = 1.0
      MOISTURE_CONTENT = 0.12
      SURFACE_VOLUME_RATIO      = 888.
      LENGTH                    = 0.10
      GEOMETRY                  = 'CYLINDRICAL' /

&SURF ID                        = 'large roundwood'
      MATL_ID(1,1) = 'GENERIC VEGETATION'
      MATL_MASS_FRACTION(1,1) = 1.0
      MOISTURE_CONTENT = 0.12
      SURFACE_VOLUME_RATIO      = 500.
      LENGTH                    = 0.10
      GEOMETRY                  = 'CYLINDRICAL' /


&PART ID='foliage', DRAG_COEFFICIENT=2.8, SAMPLING_FACTOR=1, SURF_ID='foliage'
      QUANTITIES='PARTICLE TEMPERATURE','PARTICLE MASS','PARTICLE WEIGHTING FACTOR','PARTICLE DIAMETER','INCIDENT HEAT FLUX','PARTICLE CONVECTIVE HEAT FLUX', STATIC=.TRUE., COLOR='FOREST GREEN' /
&PART ID='small roundwood', DRAG_COEFFICIENT=2.8, SAMPLING_FACTOR=1, SURF_ID='small roundwood'
      QUANTITIES='PARTICLE TEMPERATURE','PARTICLE MASS','PARTICLE WEIGHTING FACTOR','PARTICLE DIAMETER','INCIDENT HEAT FLUX','PARTICLE CONVECTIVE HEAT FLUX', STATIC=.TRUE., COLOR='BROWN' /
&PART ID='medium roundwood', DRAG_COEFFICIENT=2.8, SAMPLING_FACTOR=1, SURF_ID='medium roundwood'
      QUANTITIES='PARTICLE TEMPERATURE','PARTICLE MASS','PARTICLE WEIGHTING FACTOR','PARTICLE DIAMETER','INCIDENT HEAT FLUX','PARTICLE CONVECTIVE HEAT FLUX', STATIC=.TRUE., COLOR='BROWN' /
&PART ID='large roundwood', DRAG_COEFFICIENT=2.8, SAMPLING_FACTOR=1, SURF_ID='large roundwood'
      QUANTITIES='PARTICLE TEMPERATURE','PARTICLE MASS','PARTICLE WEIGHTING FACTOR','PARTICLE DIAMETER','INCIDENT HEAT FLUX','PARTICLE CONVECTIVE HEAT FLUX', STATIC=.TRUE., COLOR='BROWN' /








&MATL ID='wall wood', DENSITY=500., CONDUCTIVITY=.12, SPECIFIC_HEAT=1.7 /
&SURF ID='HOUSE', MATL_ID='wall wood', THICKNESS=.02, HRRPUA=200., IGNITION_TEMPERATURE=350., TAU_Q=1. /

&SURF ID='IGNITOR', HRRPUA=1000., RAMP_Q='source' /
&RAMP ID='source', T=0., F=0. /
&RAMP ID='source', T=2., F=1. /
&RAMP ID='source', T=20, F=1. /
&RAMP ID='source', T=21., F=0. /







&BNDF QUANTITY='WALL TEMPERATURE' /
&BNDF QUANTITY='INCIDENT HEAT FLUX' /
&BNDF QUANTITY='CONVECTIVE HEAT FLUX' /
&BNDF QUANTITY='RADIATIVE HEAT FLUX' /
&BNDF QUANTITY='BURNING RATE' /













































































































































































































! Artificial crown-contact initialization; no ground-fire or ember representation.
&PART ID='contact ignitor', SAMPLING_FACTOR=1, SURF_ID='contact burner', STATIC=T, AGE=21., QUANTITIES='PARTICLE TEMPERATURE' /
&SURF ID='contact burner', TMP_FRONT=1500., EMISSIVITY=1., HRRPUA=60., RAMP_T='contact', RAMP_Q='contact', RADIUS=.01, GEOMETRY='SPHERICAL' /
&RAMP ID='contact', T=0., F=0. /
&RAMP ID='contact', T=.1, F=1. /
&RAMP ID='contact', T=20, F=1. /
&RAMP ID='contact', T=20.1, F=0. /
























