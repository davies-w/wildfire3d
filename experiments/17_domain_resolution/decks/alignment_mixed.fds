&HEAD CHID='alignment_mixed', TITLE='Particle vegetation domain study: mixed' /
&MESH ID='mesh0', CHECK_MESH_ALIGNMENT=T, IJK=28,16,12, XB=8,22,8,16,0,6 /
&MESH ID='mesh1', CHECK_MESH_ALIGNMENT=T, IJK=4,12,6, XB=0,8,0,24,0,12 /
&MESH ID='mesh2', CHECK_MESH_ALIGNMENT=T, IJK=4,48,24, XB=22,24,0,24,0,12 /
&MESH ID='mesh3', CHECK_MESH_ALIGNMENT=T, IJK=7,4,6, XB=8,22,0,8,0,12 /
&MESH ID='mesh4', CHECK_MESH_ALIGNMENT=T, IJK=7,4,6, XB=8,22,16,24,0,12 /
&MESH ID='mesh5', CHECK_MESH_ALIGNMENT=T, IJK=14,8,6, XB=8,22,8,16,6,12 /
&TIME T_END=0 /
&MISC RND_SEED=1234, BNDF_DEFAULT=F /
&WIND SPEED=3., DIRECTION=270. /
&REAC FUEL='FUEL VAPOR', C=2.10, H=6.20, O=2.16, SOOT_YIELD=0.01, HEAT_OF_COMBUSTION=17425., IDEAL=T /

&SPEC ID='WATER VAPOR' /

&MATL ID                    = 'GENERIC VEGETATION'
      DENSITY               = 500.
      CONDUCTIVITY          = 0.2
      SPECIFIC_HEAT_RAMP    = 'c_v'
      A                     = 1040.
      E                     = 61041.
      NU_SPEC               = 0.75
      SPEC_ID               = 'FUEL VAPOR'
      NU_MATL               = 0.25
      MATL_ID               = 'CHAR'
      HEAT_OF_REACTION      = 418. /

&MATL ID                    = 'CHAR'
      DENSITY               = 300.
      CONDUCTIVITY          = 0.052
      SPECIFIC_HEAT_RAMP    = 'c_v'
      SURFACE_OXIDATION_MODEL = T
      A                  = 465.
      E                  = 68000. 
      SPEC_ID               = 'PRODUCTS','AIR'
      NU_SPEC               = 8.13,-7.17
      MATL_ID               = 'ASH'
      NU_MATL               = 0.04
      HEAT_OF_REACTION      = -25000. /

&MATL ID                    = 'ASH'
      DENSITY               = 67.
      CONDUCTIVITY          = 0.1
      SPECIFIC_HEAT_RAMP    = 'c_v' /

&RAMP ID='c_v', T=  0., F=1.1 /
&RAMP ID='c_v', T=200., F=2.0 /
&RAMP ID='c_v', T=800., F=2.0 /


&SURF ID                        = 'foliage'
      MATL_ID(1,1) = 'GENERIC VEGETATION'
      MATL_MASS_FRACTION(1,1) = 1.0
      MOISTURE_CONTENT         = 0.14
      SURFACE_VOLUME_RATIO      = 3940.
      LENGTH                    = 0.05
      GEOMETRY                  = 'CYLINDRICAL' /

&SURF ID                        = 'small roundwood'
      MATL_ID(1,1) = 'GENERIC VEGETATION'
      MATL_MASS_FRACTION(1,1) = 1.0
      MOISTURE_CONTENT         = 0.14
      SURFACE_VOLUME_RATIO      = 2667.
      LENGTH                    = 0.10
      GEOMETRY                  = 'CYLINDRICAL' /

&SURF ID                        = 'medium roundwood'
      MATL_ID(1,1) = 'GENERIC VEGETATION'
      MATL_MASS_FRACTION(1,1) = 1.0
      MOISTURE_CONTENT         = 0.14
      SURFACE_VOLUME_RATIO      = 888.
      LENGTH                    = 0.10
      GEOMETRY                  = 'CYLINDRICAL' /

&SURF ID                        = 'large roundwood'
      MATL_ID(1,1) = 'GENERIC VEGETATION'
      MATL_MASS_FRACTION(1,1) = 1.0
      MOISTURE_CONTENT         = 0.14
      SURFACE_VOLUME_RATIO      = 500.
      LENGTH                    = 0.10
      GEOMETRY                  = 'CYLINDRICAL' /


&PART ID='foliage', DRAG_COEFFICIENT=2.8, SAMPLING_FACTOR=10, SURF_ID='foliage'
      QUANTITIES='PARTICLE TEMPERATURE','PARTICLE MASS', STATIC=.TRUE., COLOR='FOREST GREEN' /
&PART ID='small roundwood', DRAG_COEFFICIENT=2.8, SAMPLING_FACTOR=10, SURF_ID='small roundwood'
      QUANTITIES='PARTICLE TEMPERATURE','PARTICLE MASS','PARTICLE DIAMETER', STATIC=.TRUE., COLOR='BROWN' /
&PART ID='medium roundwood', DRAG_COEFFICIENT=2.8, SAMPLING_FACTOR=10, SURF_ID='medium roundwood'
      QUANTITIES='PARTICLE TEMPERATURE','PARTICLE MASS','PARTICLE DIAMETER', STATIC=.TRUE., COLOR='BROWN' /
&PART ID='large roundwood', DRAG_COEFFICIENT=2.8, SAMPLING_FACTOR=10, SURF_ID='large roundwood'
      QUANTITIES='PARTICLE TEMPERATURE','PARTICLE MASS','PARTICLE DIAMETER', STATIC=.TRUE., COLOR='BROWN' /
&INIT PART_ID='foliage', XYZ=12.0,12.0,0.15, RADIUS=0.85, HEIGHT=1.96, SHAPE='CONE', N_PARTICLES_PER_CELL=1, DRY=T, MASS_PER_VOLUME=1.683 /
&INIT PART_ID='small roundwood', XYZ=12.0,12.0,0.15, RADIUS=0.85, HEIGHT=1.96, SHAPE='CONE', N_PARTICLES_PER_CELL=1, DRY=T, MASS_PER_VOLUME=0.289 /
&INIT PART_ID='medium roundwood', XYZ=12.0,12.0,0.15, RADIUS=0.85, HEIGHT=1.96, SHAPE='CONE', N_PARTICLES_PER_CELL=1, DRY=T, MASS_PER_VOLUME=0.263 /
&INIT PART_ID='large roundwood', XYZ=12.0,12.0,0.15, RADIUS=0.85, HEIGHT=1.96, SHAPE='CONE', N_PARTICLES_PER_CELL=1, DRY=T, MASS_PER_VOLUME=0.394 /
&INIT PART_ID='foliage', XYZ=11.0,9.0,0.15, RADIUS=0.85, HEIGHT=1.96, SHAPE='CONE', N_PARTICLES_PER_CELL=1, DRY=T, MASS_PER_VOLUME=1.683 /
&INIT PART_ID='small roundwood', XYZ=11.0,9.0,0.15, RADIUS=0.85, HEIGHT=1.96, SHAPE='CONE', N_PARTICLES_PER_CELL=1, DRY=T, MASS_PER_VOLUME=0.289 /
&INIT PART_ID='medium roundwood', XYZ=11.0,9.0,0.15, RADIUS=0.85, HEIGHT=1.96, SHAPE='CONE', N_PARTICLES_PER_CELL=1, DRY=T, MASS_PER_VOLUME=0.263 /
&INIT PART_ID='large roundwood', XYZ=11.0,9.0,0.15, RADIUS=0.85, HEIGHT=1.96, SHAPE='CONE', N_PARTICLES_PER_CELL=1, DRY=T, MASS_PER_VOLUME=0.394 /
&MATL ID='wall wood', DENSITY=500., CONDUCTIVITY=.12, SPECIFIC_HEAT=1.7 /
&SURF ID='HOUSE', MATL_ID='wall wood', THICKNESS=.02, HRRPUA=200., IGNITION_TEMPERATURE=350., TAU_Q=1. /
&OBST XB=14,20,10,14,0,4, SURF_ID='HOUSE', BNDF_OBST=T /
&SURF ID='IGNITOR', HRRPUA=1000, RAMP_Q='source' /
&RAMP ID='source', T=0., F=0. /
&RAMP ID='source', T=2., F=1. /
&RAMP ID='source', T=30., F=1. /
&RAMP ID='source', T=31., F=0. /
&VENT XB=11.5,12.5,11.5,12.5,0,0, SURF_ID='IGNITOR' /
&VENT XB=10.5,11.5,8.5,9.5,0,0, SURF_ID='IGNITOR' /
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&DEVC ID='house_max', QUANTITY='WALL TEMPERATURE', SURF_ID='HOUSE', XB=13,21,9,15,0,5, SPATIAL_STATISTIC='MAX', TEMPORAL_STATISTIC='INSTANT VALUE' /
&DEVC ID='house_flux_max', QUANTITY='GAUGE HEAT FLUX', SURF_ID='HOUSE', XB=13,21,9,15,0,5, SPATIAL_STATISTIC='MAX', TEMPORAL_STATISTIC='INSTANT VALUE' /
&DEVC ID='house_burn_max', QUANTITY='BURNING RATE', SURF_ID='HOUSE', XB=13,21,9,15,0,5, SPATIAL_STATISTIC='MAX', TEMPORAL_STATISTIC='INSTANT VALUE' /
&DEVC ID='mass foliage', QUANTITY='MPUV', PART_ID='foliage', XB=8,22,8,16,0,6, SPATIAL_STATISTIC='VOLUME INTEGRAL' /
&DEVC ID='mass small roundwood', QUANTITY='MPUV', PART_ID='small roundwood', XB=8,22,8,16,0,6, SPATIAL_STATISTIC='VOLUME INTEGRAL' /
&DEVC ID='mass medium roundwood', QUANTITY='MPUV', PART_ID='medium roundwood', XB=8,22,8,16,0,6, SPATIAL_STATISTIC='VOLUME INTEGRAL' /
&DEVC ID='mass large roundwood', QUANTITY='MPUV', PART_ID='large roundwood', XB=8,22,8,16,0,6, SPATIAL_STATISTIC='VOLUME INTEGRAL' /
&BNDF QUANTITY='WALL TEMPERATURE' /
&BNDF QUANTITY='GAUGE HEAT FLUX' /
&BNDF QUANTITY='BURNING RATE' /
&DUMP DT_DEVC=.5, DT_HRR=.5, DT_BNDF=2., DT_PART=30., DT_RESTART=100000., SMOKE3D=F /
&TAIL /
