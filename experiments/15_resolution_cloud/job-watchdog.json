{
  "taskGroups": [
    {
      "taskCount": "1",
      "parallelism": "1",
      "taskCountPerNode": "1",
      "taskSpec": {
        "computeResource": {
          "cpuMilli": 4000,
          "memoryMib": 12000
        },
        "maxRunDuration": "600s",
        "maxRetryCount": 0,
        "runnables": [
          {
            "container": {
              "imageUri": "us-central1-docker.pkg.dev/tmrw-wildfire-20261015/fds/study15@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "options": "--cpus=4 --memory=12g --pids-limit=256"
            },
            "environment": {
              "variables": {
                "TRIAL_MODE": "watchdog",
                "OUTPUT_BUCKET": "tmrw-wildfire-20261015-trial",
                "OUTPUT_PREFIX": "watchdog"
              }
            }
          }
        ]
      }
    }
  ],
  "allocationPolicy": {
    "instances": [
      {
        "policy": {
          "machineType": "c3-standard-4",
          "provisioningModel": "SPOT",
          "bootDisk": {
            "sizeGb": "30",
            "type": "pd-balanced"
          }
        }
      }
    ],
    "location": {
      "allowedLocations": [
        "zones/us-central1-a"
      ]
    },
    "serviceAccount": {
      "email": "fds-worker@tmrw-wildfire-20261015.iam.gserviceaccount.com"
    },
    "labels": {
      "trial_id": "study15"
    },
    "network": {
      "networkInterfaces": [
        {
          "network": "projects/tmrw-wildfire-20261015/global/networks/fds-trial",
          "subnetwork": "projects/tmrw-wildfire-20261015/regions/us-central1/subnetworks/fds-trial"
        }
      ]
    }
  },
  "labels": {
    "trial_id": "study15"
  },
  "logsPolicy": {
    "destination": "CLOUD_LOGGING"
  }
}
