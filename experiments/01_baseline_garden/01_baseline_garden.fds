! ============================================================================
! Single-family home in a garden, with a grass fire approaching from the west.
!
! Physics notes (all from the FDS User Guide and the bundled WUI examples):
!
!   LEVEL_SET_MODE=4  - wind and fire fully coupled.  The fire front is
!                       tracked as a level set (Rothermel-Albini spread) rather
!                       than resolved cell-by-cell, and each surface cell burns
!                       for a finite duration once the front arrives.
!
!   VEG_LSET_*        - a custom vegetation fuel type: no-wind spread rate,
!                       surface-to-volume ratio, packing ratio, height, load.
!
!   EMBER_YIELD       - the burning grass generates Lagrangian firebrands.
!                       EMBER_TRACKING_RATIO=100 means one particle stands in
!                       for 100 real embers.
!
!   IGNITION_TEMPERATURE - the house surfaces ignite when their *surface*
!                       temperature reaches the given value.  This is the
!                       approach the FDS developers recommend over reaction
!                       parameters at this resolution, and it is mutually
!                       exclusive with REFERENCE_TEMPERATURE.
!
! The experiment: does the fire reach the house, and does the mown defensible
! space around it change the outcome?
! ============================================================================

&HEAD CHID='01_baseline_garden',
      TITLE='Single family home in a garden - grass fire from the west' /

! --- 40 m x 40 m garden, 12 m tall, 1 m cells --------------------------------
&MESH ID='garden', IJK=40,40,12, XB=0,40, 0,40, 0,12 /

&TIME T_END=120. /

&MISC LEVEL_SET_MODE=4, CFL_MAX=0.8 /

&WIND SPEED=6.0, DIRECTION=270.0 /     ! 6 m/s from the west, blowing east

! --- combustion ---------------------------------------------------------------
! Use a wood/grass-like fuel, NOT propane.  The level-set burn rate is
!     HRR/m2 = (1 - char_fraction) * load / burn_duration * HEAT_OF_COMBUSTION
! so the reaction's heat of combustion scales the whole fire.  Propane is
! 46.5 MJ/kg against 17.3 MJ/kg for wood -- a 2.7x over-prediction.
&SPEC ID='WOOD FUEL VAPOR'
      O = 2.5
      C = 3.4
      H = 6.2 /

&REAC FUEL='WOOD FUEL VAPOR'
      FYI='Ritchie et al., 5th IAFSS'
      SOOT_YIELD = 0.02
      HEAT_OF_COMBUSTION = 17260. /

! ============================================================================
! FUEL MODELS
! ============================================================================

! Wild, tall, dry grass everywhere by default.  This is the fire carrier.
! Burn intensity comes from the fuel model, not from HRRPUA:
!     m''_f = (1 - char_fraction) * load / burn_duration
! With load 0.2 kg/m2 and a 25 s burn that is ~0.0064 kg/m2/s, i.e. about
! 110 kW/m2 -- a realistic grass fire.  (An earlier version used 0.6 kg/m2
! and the 6.6 s default burn, which produced 1.9 GW and blew the mesh up.)
&SURF ID         = 'GRASS'
      DEFAULT    = .TRUE.
      RGB        = 138,129,62
      VEG_LSET_ROS_00     = 0.08        ! no-wind, no-slope spread rate [m/s]
      VEG_LSET_SIGMA      = 11400.      ! surface-to-volume ratio [1/m]
      VEG_LSET_BETA       = 0.0012      ! packing ratio
      VEG_LSET_HT         = 0.5         ! vegetation height [m]
      VEG_LSET_SURF_LOAD  = 0.2         ! dry fuel load [kg/m2]
      VEG_LSET_CHAR_FRACTION = 0.2
      VEG_LSET_FIREBASE_TIME = 18.0     ! burn duration at a point [s]
      HRRPUA               = 30.        ! heat release when burning [kW/m2]
      EMBER_YIELD          = 0.01       ! kg embers per kg fuel burnt
      EMBER_TRACKING_RATIO = 500.0      ! 1 particle stands for 500 embers
      PART_ID              = 'brands' /

! Mown, irrigated lawn forming the defensible space around the house.
! Same fuel type but a much slower spread rate, a shorter bed and a lighter,
! wetter load -- the practical effect is that the front stalls here.
&SURF ID         = 'LAWN'
      RGB        = 96,160,64
      VEG_LSET_ROS_00     = 0.02
      VEG_LSET_SIGMA      = 14000.
      VEG_LSET_BETA       = 0.0008
      VEG_LSET_HT         = 0.08
      VEG_LSET_SURF_LOAD  = 0.06
      VEG_LSET_CHAR_FRACTION = 0.2
      VEG_LSET_FIREBASE_TIME = 30.0
      HRRPUA               = 12. /

! ============================================================================
! HOUSE - reinforced by simple, ignition-prone materials
! ============================================================================

&MATL ID            = 'WOOD'
      CONDUCTIVITY  = 0.12
      SPECIFIC_HEAT = 1.7
      DENSITY       = 500.0 /

&SURF ID            = 'WOOD WALL'
      RGB           = 222,184,135      ! tan.  NB: FDS 'BROWN' = X11 brown
                                       ! = RGB(165,42,42), which reads as fire-red
      MATL_ID       = 'WOOD'
      THICKNESS     = 0.02
      HRRPUA        = 200.0
      IGNITION_TEMPERATURE = 350.0      ! degrees C
      RAMP_Q        = 'wood_burn' /

&RAMP ID='wood_burn', T=  0.0, F=0.0 /
&RAMP ID='wood_burn', T= 30.0, F=1.0 /
&RAMP ID='wood_burn', T=300.0, F=0.8 /
&RAMP ID='wood_burn', T=600.0, F=0.3 /

! Roof covering - deliberately more resistant (a Class-A style assembly).
&SURF ID            = 'ROOF'
      COLOR         = 'DARK GRAY'
      MATL_ID       = 'WOOD'
      THICKNESS     = 0.02
      HRRPUA        = 100.0
      IGNITION_TEMPERATURE = 550.0
      RAMP_Q        = 'roof_burn' /

&RAMP ID='roof_burn', T=  0.0, F=0.0 /
&RAMP ID='roof_burn', T= 60.0, F=1.0 /
&RAMP ID='roof_burn', T=600.0, F=0.2 /

! Glazing - fails early, which is why windows are the classic weak point.
&SURF ID            = 'GLASS'
      COLOR         = 'LIGHT BLUE'
      MATL_ID       = 'WOOD'
      THICKNESS     = 0.006
      HRRPUA        = 50.0
      IGNITION_TEMPERATURE = 180.0
      RAMP_Q        = 'roof_burn' /

! --- house body: 12 m x 8 m, walls 3.5 m to the eave
&OBST XB=21.0,33.0, 16.0,24.0, 0.0,3.5, SURF_ID='WOOD WALL' /

! --- gable roof as a genuine triangulated solid.
!     &OBST can only make axis-aligned boxes, which is why an earlier version
!     used three stacked slabs and looked like a step pyramid.  &GEOM takes
!     arbitrary vertices, so this is a real 25-degree gable with 0.4 m eaves.
!
!     It is defined as a CLOSED solid (the bottom face is included).  That
!     matters: a roof left open underneath would enclose the attic as a sealed
!     pressure zone, which the User Guide warns can trigger instabilities.
!     A closed surface is recognised as solid and simply filled.
!
!     Face vertex order is counter-clockwise seen from outside, so the
!     right-hand normal points outward.  b=1 selects the first SURF_ID entry.
!
!        V5 -------- V6          ridge, z=5.6
!       /            \
!     V1 --- V2      \         eaves, z=3.5
!     |      |        \
!     V4 --- V3
!
&GEOM ID='ROOF', SURF_ID='ROOF',
      VERTS=
        20.6, 15.6, 3.5,      ! V1  west eave, north side
        33.4, 15.6, 3.5,      ! V2  east eave, north side
        33.4, 24.4, 3.5,      ! V3  east eave, south side
        20.6, 24.4, 3.5,      ! V4  west eave, south side
        20.6, 20.0, 5.6,      ! V5  west ridge end
        33.4, 20.0, 5.6,      ! V6  east ridge end
      FACES=
        1, 3, 2, 1,           ! bottom (normal -z)
        1, 4, 3, 1,           ! bottom
        1, 2, 6, 1,           ! north slope (normal -y,+z)
        1, 6, 5, 1,           ! north slope
        4, 6, 3, 1,           ! south slope (normal +y,+z)
        4, 5, 6, 1,           ! south slope
        1, 5, 4, 1,           ! west gable end (normal -x)
        2, 3, 6, 1 /          ! east gable end (normal +x)

! --- two windows on the west wall, facing the oncoming fire
&VENT XB=21.0,21.0, 17.5,19.0, 1.0,2.2, SURF_ID='GLASS' /
&VENT XB=21.0,21.0, 21.0,22.5, 1.0,2.2, SURF_ID='GLASS' /

! ============================================================================
! GROUND SURFACE PATCHES
! ============================================================================

! Firebrands generated by the burning grass (see the PART block below).
&PART ID       = 'brands'
      DRAG_LAW = 'DISK'
      SURF_ID  = 'firebrand'
      COLOR    = 'ORANGE'
      AGE      = 60.0
      QUANTITIES = 'PARTICLE TEMPERATURE' /

&SURF ID            = 'firebrand'
      MATL_ID       = 'CHAR'
      THICKNESS     = 0.0005
      LENGTH        = 0.005
      WIDTH         = 0.005
      HEAT_TRANSFER_COEFFICIENT = 20.0
      GEOMETRY      = 'CARTESIAN' /

&MATL ID            = 'CHAR'
      DENSITY       = 110.0
      CONDUCTIVITY  = 0.1
      EMISSIVITY    = 1.0
      SPECIFIC_HEAT = 10000.0 /

! Defensible space: mown lawn overrides the default grass near the house.
&VENT XB=16.0,40.0, 12.0,28.0, 0.0,0.0, SURF_ID='LAWN' /

! Ignition: a small patch of grass alight at t=0, at the western edge.
&SURF ID = 'SPOT IGN', VEG_LSET_IGNITE_TIME = 0.0, COLOR = 'RED' /
&VENT XB=1.0,4.0, 18.0,22.0, 0.0,0.0, SURF_ID='SPOT IGN' /

! ============================================================================
! BOUNDARIES - open domain
! ============================================================================
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

! ============================================================================
! OUTPUT
! ============================================================================

! Fire perimeter, drawn over the fuel bed
&SLCF AGL_SLICE=1.0, QUANTITY='LEVEL SET VALUE' /

! Vertical cross-section straight through the house, along the wind
&SLCF PBY=20.0, QUANTITY='TEMPERATURE' /
&SLCF PBY=20.0, QUANTITY='VELOCITY', VECTOR=.TRUE. /

! Ground-level gas temperature
&SLCF AGL_SLICE=1.0, QUANTITY='TEMPERATURE' /

! Surface temperatures on the building - this is how you see ignition coming
&BNDF QUANTITY='WALL TEMPERATURE' /
&BNDF QUANTITY='BURNING RATE' /

! Time histories
&DEVC ID='HRR', QUANTITY='HRR', XB=0,40, 0,40, 0,12 /
&DEVC ID='garden fuel burnt', QUANTITY='BURNING RATE',
      SPATIAL_STATISTIC='SURFACE INTEGRAL', TEMPORAL_STATISTIC='TIME INTEGRAL',
      XB=0,40, 0,40, 0,12, IOR=3 /

&DUMP DT_SLCF=2.0, DT_BNDF=2.0, DT_HRR=1.0, DT_DEVC=1.0, DT_PART=2.0 /

&TAIL /
